---
import '@fontsource-variable/brygada-1918/wght.css';
import '@fontsource-variable/brygada-1918/wght-italic.css';
import '@fontsource-variable/albert-sans/wght.css';
import '../styles/luxe.css';
import { site, type Lang } from '../config';
import { ORIGIN, jsonLd, ogLocale } from '../lib/seo';

interface Props {
  lang: Lang;
  htmlLang: string;
  title: string;
  description: string;
  /** Opis obrazka OG (co na nim jest), nie powtórka tytułu */
  imageAlt: string;
  /** Ścieżka strony (canonical). Domyślnie strona główna. */
  path?: string;
  /** Dane strukturalne; domyślnie graf firmy dla strony głównej, null = bez JSON-LD */
  ld?: unknown;
  /** Strona techniczna (np. 404): zawsze poza indeksem */
  noindex?: boolean;
}
const { lang, htmlLang, title, description, imageAlt, noindex = false, path = '/' } = Astro.props;
const canonical = `${ORIGIN}${path}`;
const ogImage = `${ORIGIN}/img/og.png`;
const ld = Astro.props.ld === undefined ? jsonLd(lang) : Astro.props.ld;
const indexable = site.indexable && !noindex;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : noindex ? 'noindex, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#F7F4EE" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
    <!-- Ruch: otwarcie ukryte tylko do startu animacji; gdyby skrypt się nie wczytał, treść pokaże się po 2,5 s -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('motion');
        window.__motionFallback = setTimeout(function () { d.classList.remove('motion'); }, 2500);
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>import '../scripts/motion';</script>
  </body>
</html>
