---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '../styles/global.css';
import { locales, site, type Lang } from '../config';
import { ORIGIN, jsonLd, ogLocale } from '../lib/seo';

interface Props {
  lang: Lang;
  htmlLang: string;
  title: string;
  description: string;
  /** Opis obrazka OG (co na nim jest), nie powtórka tytułu */
  imageAlt: string;
  /** Ścieżka tej samej strony w każdym języku (canonical, hreflang). Domyślnie strona główna. */
  paths?: Record<Lang, string>;
  /** Dane strukturalne; domyślnie graf firmy dla strony głównej, null = bez JSON-LD */
  ld?: unknown;
  /** Strona techniczna (np. 404): zawsze poza indeksem */
  noindex?: boolean;
}
const { lang, htmlLang, title, description, imageAlt, noindex = false } = Astro.props;
const paths = Astro.props.paths ?? (Object.fromEntries(locales.map((l) => [l, `/${l}/`])) as Record<Lang, string>);
const canonical = `${ORIGIN}${paths[lang]}`;
const ogImage = `${ORIGIN}/img/og.png`;
const ld = Astro.props.ld === undefined ? jsonLd(lang) : Astro.props.ld;
const indexable = site.indexable && !noindex;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : noindex ? 'noindex, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#F9F6EB" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {!noindex && locales.map((l) => <link rel="alternate" hreflang={l} href={`${ORIGIN}${paths[l]}`} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={`${ORIGIN}${paths.pl}`} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
