---
// Kroje jak w referencji (Cyprianerhof): Garamond do nagłówków, Mona Sans do tekstu i interfejsu
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource-variable/mona-sans/wght.css';
import '../styles/ref.css';
// Pliki z tekstem otwarcia i wstępu (łacina + polskie znaki): przeglądarka pobiera je od razu, nie po CSS
import garamondLatin from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';
import garamondLatinExt from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-ext-wght-normal.woff2?url';
import monaLatin from '@fontsource-variable/mona-sans/files/mona-sans-latin-wght-normal.woff2?url';
import { site, type Lang } from '../config';
import { ORIGIN, jsonLd, ogLocale } from '../lib/seo';

interface Props {
  lang: Lang;
  htmlLang: string;
  title: string;
  description: string;
  /** Opis obrazka OG (co na nim jest), nie powtórka tytułu */
  imageAlt: string;
  /** Ścieżka strony (canonical). Domyślnie strona główna. */
  path?: string;
  /** Dane strukturalne; domyślnie graf firmy dla strony głównej, null = bez JSON-LD */
  ld?: unknown;
  /** Strona techniczna (np. 404): zawsze poza indeksem */
  noindex?: boolean;
}
const { lang, htmlLang, title, description, imageAlt, noindex = false, path = '/' } = Astro.props;
const canonical = `${ORIGIN}${path}`;
const ogImage = `${ORIGIN}/img/og.png`;
const ld = Astro.props.ld === undefined ? jsonLd(lang) : Astro.props.ld;
const indexable = site.indexable && !noindex;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : noindex ? 'noindex, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#2D2D2D" />
    <link rel="preload" href={garamondLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={garamondLatinExt} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monaLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
    <!-- Bez JavaScriptu wszystkie zakładki są widoczne jedna pod drugą -->
    <noscript><style>[role="tabpanel"][hidden] { display: block !important; } .themes__tabs, .pills { display: none !important; }</style></noscript>
  </head>
  <body>
    <slot />
  </body>
</html>
