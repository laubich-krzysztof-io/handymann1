---
// Strona 404
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { content } from '../i18n/content';
import { site } from '../config';

const t = content.pl;
---
<Base lang="pl" htmlLang="pl" title={`Nie ma takiej strony | ${site.name}`} description="Ta strona nie istnieje albo zmieniła adres." imageAlt={`${site.name} – ${t.brand.sub}`} ld={null} noindex>
  <Header lang="pl" sub />
  <main id="main" tabindex="-1">
    <section class="section doc">
      <div class="wrap doc__in lost">
        <h1>Tej strony nie ma.</h1>
        <p class="lead">Adres mógł się zmienić albo zawiera literówkę. Proszę zacząć od strony głównej albo od razu opisać usterkę.</p>
        <div class="actions">
          <a class="btn" href="/">Strona główna</a>
          <a class="call-link" href="/#kontakt">{t.hero.primary}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang="pl" />
</Base>
