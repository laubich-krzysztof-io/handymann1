---
// Strona 404: po polsku, z krótkimi wersjami DE/EN i powrotem do każdej wersji językowej
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { content } from '../i18n/content';
import { site } from '../config';

const t = content.pl;
const others = [
  { lang: 'de', title: 'Diese Seite gibt es nicht.', link: 'Zur Startseite' },
  { lang: 'en', title: 'This page does not exist.', link: 'Go to the home page' },
] as const;
---
<Base lang="pl" htmlLang="pl" title={`Nie ma takiej strony | ${site.name}`} description="Ta strona nie istnieje albo zmieniła adres." imageAlt={`${site.name} – ${t.brand.sub}`} ld={null} noindex>
  <Header lang="pl" sub />
  <main id="main">
    <section class="section doc">
      <div class="wrap doc__in lost">
        <h1>Tej strony nie ma.</h1>
        <p class="lead">Adres mógł się zmienić albo zawiera literówkę. Zacznij od strony głównej albo od razu opisz usterkę.</p>
        <div class="actions">
          <a class="btn" href="/pl/">Strona główna</a>
          <a class="call-link" href="/pl/#kontakt">{t.hero.primary}</a>
        </div>
        <ul class="lost__other">
          {others.map((o) => (
            <li lang={o.lang}><span>{o.title}</span> <a href={`/${o.lang}/`} hreflang={o.lang}>{o.link}</a></li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer lang="pl" />
</Base>
