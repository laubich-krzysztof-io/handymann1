---
// Polityka prywatności: /pl/prywatnosc/, /de/datenschutz/, /en/privacy/
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { content } from '../../i18n/content';
import { privacy, privacyPath } from '../../i18n/privacy';
import { locales, site, type Lang } from '../../config';
import { ORIGIN } from '../../lib/seo';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang, slug: privacy[lang].slug } }));
}

const lang = Astro.params.lang as Lang;
const t = content[lang];
const pv = privacy[lang];
const paths = Object.fromEntries(locales.map((l) => [l, privacyPath(l)])) as Record<Lang, string>;
const skip: Record<Lang, string> = { pl: 'Przejdź do treści', de: 'Zum Inhalt springen', en: 'Skip to content' };
const url = `${ORIGIN}${paths[lang]}`;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${url}#page`,
  url,
  name: pv.title,
  description: pv.description,
  inLanguage: lang,
  isPartOf: { '@id': `${ORIGIN}/#website` },
  about: { '@id': `${ORIGIN}/#business` },
};
---
<Base lang={lang} htmlLang={t.htmlLang} title={`${pv.title} | ${site.name}`} description={pv.description} imageAlt={`${site.name} – ${t.brand.sub}`} paths={paths} ld={ld}>
  <a class="skip" href="#main">{skip[lang]}</a>
  <Header lang={lang} sub alternates={paths} />

  <main id="main">
    <article class="section doc">
      <div class="wrap doc__in">
        <header class="doc__head">
          <h1>{pv.heading ?? pv.title}</h1>
          <p class="lead">{pv.lead}</p>
          <p class="fine">{pv.updated}</p>
        </header>
        {pv.sections.map((sec) => (
          <section class="doc__sec">
            <h2>{sec.h}</h2>
            {sec.p?.map((para) => <p>{para}</p>)}
            {sec.list && <ul>{sec.list.map((li) => <li>{li}</li>)}</ul>}
          </section>
        ))}
        <a class="plan__link doc__back" href={`/${lang}/`}>{pv.back}<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12h14M13 6.5l5.5 5.5-5.5 5.5"/></svg></a>
      </div>
    </article>
  </main>

  <Footer lang={lang} />
</Base>
