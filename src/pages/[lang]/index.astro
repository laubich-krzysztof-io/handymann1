---
import Base from '../../layouts/Base.astro';
import { content } from '../../i18n/content';
import { locales, site, type Lang } from '../../config';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = content[lang];
const tel = site.phone.replace(/\s/g, '');
const gallery = site.gallery;
const skip: Record<Lang, string> = { pl: 'Przejdź do treści', de: 'Zum Inhalt springen', en: 'Skip to content' };
const locale = { pl: 'pl-PL', de: 'de-DE', en: 'en-GB' }[lang];
---
<Base lang={lang} htmlLang={t.htmlLang} title={t.meta.title} description={t.meta.description}>
  <a class="skip" href="#main">{skip[lang]}</a>

  <header class="top">
    <div class="wrap top__in">
      <a class="brand" href={`/${lang}/`}>{site.name}</a>
      <nav class="nav" aria-label="Main">
        <a href="#uslugi">{t.nav.services}</a>
        <a href="#opieka">{t.nav.care}</a>
        <a href="#jak">{t.nav.process}</a>
      </nav>
      <div class="top__end">
        <ul class="lang" aria-label="Language">
          {locales.map((l) => (
            <li><a href={`/${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a></li>
          ))}
        </ul>
        <a class="btn btn--small" href="#kontakt">{t.nav.contact}</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- Hero: kwit zlecenia na zielonym polu -->
    <section class="hero">
      <div class="wrap">
        <div class="ticket reveal">
          <div class="ticket__main">
            <h1>{t.hero.title}</h1>
            <p class="hero__lead">{t.hero.lead}</p>
            <a class="btn" href="#kontakt">{t.hero.primary}</a>
          </div>
          <div class="ticket__stub" aria-label={t.ticket.title}>
            <p class="stub__title">{t.ticket.title}</p>
            <ul class="stub__list">
              {t.services.items.map((s) => <li>{s.name}</li>)}
            </ul>
            <p class="stub__place">Karkonosze</p>
          </div>
        </div>
        <ul class="audience reveal">
          {t.hero.audience.map((a) => <li>{a}</li>)}
        </ul>
      </div>
    </section>

    <!-- Usługi: arkusz zlecenia -->
    <section id="uslugi" class="sheet-wrap">
      <div class="wrap">
        <div class="sheet">
          <div class="sheet__head reveal">
            <h2>{t.services.title}</h2>
            <p>{t.services.lead}</p>
          </div>
          <ul class="jobs">
            {t.services.items.map((s) => (
              <li class="job reveal">
                <span class="job__box" aria-hidden="true"></span>
                <div>
                  <h3>{s.name}</h3>
                  <p>{s.text}</p>
                  <p class="job__ex">{s.examples}</p>
                </div>
              </li>
            ))}
          </ul>
          <p class="sheet__note reveal">{t.services.note}</p>
        </div>
      </div>
    </section>

    <!-- Stała opieka: strona z zeszytu usterek -->
    <section id="opieka" class="care">
      <div class="wrap care__in">
        <div class="care__copy">
          <h2 class="reveal">{t.care.title}</h2>
          <p class="care__lead reveal">{t.care.lead}</p>
          <ul class="care__points">
            {t.care.points.map((p) => (
              <li class="reveal">
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))}
          </ul>
          <a class="btn btn--paper reveal" href="#kontakt">{t.care.cta}</a>
        </div>

        <figure class="logbook reveal" aria-label={t.log.title}>
          <p class="logbook__title">{t.log.title}</p>
          <ol class="logbook__rows">
            {t.log.entries.map((e) => (
              <li>
                <span class="lb__when">{e.when}</span>
                <span class="lb__where">{e.where}</span>
                <span class="lb__what">{e.what}</span>
                <span class="lb__done">{e.done}</span>
              </li>
            ))}
          </ol>
          <figcaption>{t.log.note}</figcaption>
        </figure>
      </div>
    </section>

    <!-- Jak to idzie: odcinki kwitu -->
    <section id="jak" class="route">
      <div class="wrap">
        <h2 class="reveal">{t.process.title}</h2>
        <ol class="stubs">
          {t.process.steps.map((s) => (
            <li class="stubs__item reveal">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Zaufanie -->
    <section id="zaufanie" class="trust">
      <div class="wrap">
        <h2 class="reveal">{t.trust.title}</h2>
        <ul class="trust__list">
          {t.trust.items.map((i) => (
            <li class="reveal">
              <h3>{i.title}</h3>
              <p>{i.text}</p>
            </li>
          ))}
        </ul>
        {gallery.length > 0 && (
          <ul class="gallery">
            {gallery.map((g) => (
              <li><img src={g.src} alt={g.alt[lang]} loading="lazy" /></li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <!-- Kontakt: żywe zlecenie -->
    <section id="kontakt" class="order">
      <div class="wrap">
        <div class="order__head reveal">
          <h2>{t.contact.title}</h2>
          <p>{t.contact.lead}</p>
        </div>

        <div class="order__in">
          <form id="lead" class="form reveal" novalidate data-wa={site.whatsapp} data-mail={site.email} data-locale={locale}
            data-l-number={t.ticket.number} data-l-date={t.ticket.date} data-l-from={t.ticket.from} data-l-property={t.ticket.property}
            data-l-place={t.ticket.place} data-l-issue={t.ticket.issue} data-l-phone={t.contact.form.phone} data-l-title={t.ticket.title}>
            <label>
              <span>{t.contact.form.name} <small>({t.contact.form.required})</small></span>
              <input name="name" autocomplete="name" required aria-describedby="form-error" />
            </label>
            <label>
              <span>{t.contact.form.phone}</span>
              <input name="phone" type="tel" autocomplete="tel" inputmode="tel" />
            </label>
            <label>
              <span>{t.contact.form.who}</span>
              <select name="who">
                {t.contact.form.whoOptions.map((o) => <option value={o}>{o}</option>)}
              </select>
            </label>
            <label>
              <span>{t.contact.form.where}</span>
              <input name="where" placeholder={t.contact.form.wherePlaceholder} />
            </label>
            <label class="form__wide">
              <span>{t.contact.form.what} <small>({t.contact.form.required})</small></span>
              <textarea name="what" rows="3" required aria-describedby="form-error" placeholder={t.contact.form.whatPlaceholder}></textarea>
            </label>
            <p id="form-error" class="form__error form__wide" role="alert" hidden>{t.contact.form.error}</p>
            <div class="actions form__wide">
              <button class="btn" type="button" data-send="wa">{t.contact.form.whatsapp}</button>
              <button class="btn btn--quiet" type="button" data-send="mail">{t.contact.form.email}</button>
            </div>
            <p class="form__hint form__wide">{t.contact.form.hint}</p>
          </form>

          <aside class="slip reveal" aria-live="polite" aria-label={t.ticket.title}>
            <p class="slip__title">{t.ticket.title}</p>
            <dl class="slip__rows">
              <div><dt>{t.ticket.number}</dt><dd data-slip="number">HM-0000</dd></div>
              <div><dt>{t.ticket.date}</dt><dd data-slip="date">{t.ticket.empty}</dd></div>
              <div><dt>{t.ticket.from}</dt><dd data-slip="name">{t.ticket.empty}</dd></div>
              <div><dt>{t.ticket.property}</dt><dd data-slip="who">{t.contact.form.whoOptions[0]}</dd></div>
              <div><dt>{t.ticket.place}</dt><dd data-slip="where">{t.ticket.empty}</dd></div>
              <div class="slip__issue"><dt>{t.ticket.issue}</dt><dd data-slip="what">{t.ticket.empty}</dd></div>
              <div><dt>{t.ticket.status}</dt><dd class="slip__status">{t.ticket.statusValue}</dd></div>
            </dl>
          </aside>
        </div>

        <div class="direct reveal">
          <p>{t.contact.direct} <a href={`tel:${tel}`}>{site.phone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
          <p>{t.contact.area}</p>
        </div>
      </div>
    </section>
  </main>

  <!-- Stopka: odwrocie kwitu -->
  <footer class="foot">
    <div class="wrap">
      <p class="foot__name" aria-hidden="true">{site.name}</p>
      <div class="foot__row">
        <span>{t.footer.area}</span>
        <span>© {new Date().getFullYear()} {site.company || site.name}. {t.footer.rights}</span>
      </div>
    </div>
  </footer>

  <script>
    // Wejścia sekcji: treść widoczna bez JS, animacja tylko gdy JS działa
    const root = document.documentElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce && 'IntersectionObserver' in window) {
      root.classList.add('js-reveal');
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => {
        const sibs = el.parentElement ? [...el.parentElement.children].filter((c) => c.classList.contains('reveal')) : [];
        (el as HTMLElement).style.setProperty('--d', `${Math.max(0, sibs.indexOf(el)) * 75}ms`);
        io.observe(el);
      });
    }

    // Żywe zlecenie
    const form = document.getElementById('lead') as HTMLFormElement | null;
    if (form) {
      const d = form.dataset;
      const now = new Date();
      const pad = (n: number) => String(n).padStart(2, '0');
      const number = `HM-${String(now.getFullYear()).slice(2)}${pad(now.getMonth() + 1)}${pad(now.getDate())}-${pad(now.getHours())}${pad(now.getMinutes())}`;
      const date = now.toLocaleDateString(d.locale, { day: 'numeric', month: 'long', year: 'numeric' });
      const slip = (k: string) => document.querySelector<HTMLElement>(`[data-slip="${k}"]`);
      const empty = slip('name')?.textContent || '…';
      slip('number')!.textContent = number;
      slip('date')!.textContent = date;
      const val = (n: string) => ((form.elements.namedItem(n) as HTMLInputElement).value || '').trim();
      const sync = () => {
        for (const k of ['name', 'who', 'where', 'what']) {
          const el = slip(k);
          if (!el) continue;
          const v = val(k) || empty;
          if (el.textContent !== v) {
            el.textContent = v;
            el.classList.remove('is-ink');
            void el.offsetWidth;
            el.classList.add('is-ink');
          }
        }
      };
      form.addEventListener('input', sync);
      form.addEventListener('change', sync);

      const build = () => [
        `${d.lTitle} ${number}`,
        `${d.lDate}: ${date}`,
        `${d.lFrom}: ${val('name')}`,
        `${d.lPhone}: ${val('phone')}`,
        `${d.lProperty}: ${val('who')}`,
        `${d.lPlace}: ${val('where')}`,
        '',
        `${d.lIssue}:`,
        val('what'),
      ].join('\n');

      const valid = () => {
        const name = form.elements.namedItem('name') as HTMLInputElement;
        const what = form.elements.namedItem('what') as HTMLTextAreaElement;
        const ok = name.value.trim() !== '' && what.value.trim() !== '';
        name.setAttribute('aria-invalid', String(name.value.trim() === ''));
        what.setAttribute('aria-invalid', String(what.value.trim() === ''));
        const err = document.getElementById('form-error');
        if (err) err.hidden = ok;
        if (!ok) (name.value.trim() === '' ? name : what).focus();
        return ok;
      };
      form.querySelectorAll<HTMLButtonElement>('[data-send]').forEach((b) =>
        b.addEventListener('click', () => {
          if (!valid()) return;
          const text = build();
          if (b.dataset.send === 'wa') {
            window.open(`https://wa.me/${d.wa}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
          } else {
            location.href = `mailto:${d.mail}?subject=${encodeURIComponent(`${d.lTitle} ${number}`)}&body=${encodeURIComponent(text)}`;
          }
        }),
      );
    }
  </script>
</Base>
