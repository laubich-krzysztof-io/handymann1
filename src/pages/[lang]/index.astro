---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import ContactForm from '../../components/ContactForm.astro';
import PriceEstimator from '../../components/PriceEstimator.astro';
import WorkGallery from '../../components/WorkGallery.astro';
import { content } from '../../i18n/content';
import { redesign } from '../../i18n/redesign';
import { locales, site, type Lang } from '../../config';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = content[lang];
const r = redesign[lang];
const tel = site.phone.replace(/\s/g, '');
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(t.waGreeting)}`;
const skip = { pl: 'Przejdź do treści', de: 'Zum Inhalt springen', en: 'Skip to content' }[lang];
const serviceIcons = ['wrench', 'plug', 'drill', 'home'];
---

<Base
  lang={lang}
  htmlLang={t.htmlLang}
  title={t.meta.title}
  description={t.meta.description}
  imageAlt={`${site.name} – ${t.brand.sub}`}
>
  <a class="skip" href="#main">
    {skip}
  </a>
  <Header lang={lang} />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero__in">
        <div class="hero__copy">
          <p class="eyebrow hero__eyebrow">
            <Icon name="pin" />
            {r.location}
          </p>
          <h1 id="hero-title">
            {r.title[0]}
            <span>{r.title[1]}</span>
          </h1>
          <p class="hero__intro">{r.intro}</p>
          <div class="actions">
            <a class="btn btn--yellow" href="#kontakt">
              {t.hero.primary}
              <Icon name="diagonal" />
            </a>
            <a class="hero__estimate" href="#cennik">
              {r.estimate}
              <Icon name="arrow" />
            </a>
          </div>
          <p class="hero__personal">{r.personal}</p>
        </div>
        <a class="hero__visual" href="#realizacja" aria-label={r.photoLink}>
          <img
            class="hero__image"
            src="/img/mural-gotowe-900.webp"
            srcset="/img/mural-gotowe-900.webp 675w, /img/mural-gotowe-1600.webp 1200w"
            sizes="(min-width: 800px) 42vw, 100vw"
            width="1200"
            height="1600"
            alt={t.work.photos.gotowe}
            fetchpriority="high"
          />
          <span class="hero__photo-label">
            <Icon name="camera" />
            {r.photoLabel}
          </span>
          <span class="hero__caption">
            <span>
              {r.photoCaption}
              <small>{r.photoLink}</small>
            </span>
            <span class="round-arrow">
              <Icon name="diagonal" />
            </span>
          </span>
        </a>
      </div>
      <div class="wrap hero__bottom">
        <span>Jelenia Góra · Karpacz · Szklarska Poręba</span>
        <a href="#obszar">
          {site.radiusKm} km <Icon name="pin" />
        </a>
      </div>
    </section>

    <div class="assurances">
      <div class="wrap assurances__in">
        {t.trust.items.map((item, i) => (
          <a href="#zaufanie">
            <Icon name={['shield', 'camera', 'person'][i]} />
            <span>{item.title}</span>
            <Icon name="check" />
          </a>
        ))}
      </div>
    </div>

    <section id="uslugi" class="section services" aria-labelledby="services-title">
      <div class="wrap">
        <div class="section__head">
          <div>
            <p class="eyebrow">{r.serviceEyebrow}</p>
            <h2 class="line-breaks" id="services-title">
              {r.serviceTitle}
            </h2>
          </div>
          <p class="lead">{t.services.lead}</p>
        </div>
        <div class="service-grid">
          {t.services.items.map((item, i) => (
            <a
              class="service"
              href={i === 3 ? '#opieka' : '#kontakt'}
              data-service={i === 3 ? undefined : item.name}
            >
              <span class="service__top">
                <Icon name={serviceIcons[i]} />
                <Icon name="diagonal" />
              </span>
              <h3>{item.name}</h3>
              <p>{item.text}</p>
              <span class="service__link">{i === 3 ? r.careLink : r.serviceCta}</span>
            </a>
          ))}
        </div>
        <p class="services__note">
          <Icon name="shield" />
          {t.services.note}
        </p>
      </div>
    </section>

    <section id="realizacja" class="section work" aria-labelledby="work-title">
      <div class="wrap work__in">
        <WorkGallery lang={lang} />
        <div class="work__copy">
          <p class="eyebrow">{r.workEyebrow}</p>
          <h2 class="line-breaks" id="work-title">
            {r.workTitle}
          </h2>
          <p class="lead">{t.work.lead}</p>
          <dl class="work__facts">
            {t.work.facts.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
          <a class="text-link" href="#kontakt" data-service={t.services.items[2].name}>
            {t.hero.primary}
            <Icon name="arrow" />
          </a>
        </div>
      </div>
    </section>

    <section id="opieka" class="section care" aria-labelledby="care-title">
      <div class="wrap care__in">
        <div class="care__copy">
          <p class="eyebrow">{r.careEyebrow}</p>
          <h2 class="line-breaks" id="care-title">
            {r.careTitle}
          </h2>
          <p class="lead">{t.care.lead}</p>
          <ul class="care__points">
            {t.care.points.map((point) => (
              <li>
                <Icon name="check" />
                <div>
                  <h3>{point.title}</h3>
                  <p>{point.text}</p>
                </div>
              </li>
            ))}
          </ul>
          <a class="btn btn--dark" href="#kontakt" data-service={t.services.items[3].name}>
            {t.care.cta}
            <Icon name="arrow" />
          </a>
        </div>
        <div class="care__aside">
          <div class="log">
            <div class="log__head">
              <Icon name="home" />
              <h3>{t.log.title}</h3>
            </div>
            <p class="log__note">{t.log.note}</p>
            <ul>
              {t.log.entries.slice(0, 3).map((entry) => (
                <li>
                  <span class="log__check">
                    <Icon name="check" />
                  </span>
                  <div>
                    <span class="log__where">
                      {entry.where}
                      <small>{entry.when}</small>
                    </span>
                    <p>{entry.what}</p>
                    <span class="log__done">{entry.done}</span>
                  </div>
                </li>
              ))}
            </ul>
            <div class="log__footer">
              <span>{t.pricing.care.points[2]}</span>
              <Icon name="shield" />
            </div>
          </div>
          <div class="care-plan">
            <div>
              <span>{t.pricing.care.title}</span>
              <strong>
                {t.pricing.care.price}
                <small>
                  {' '}
                  {t.pricing.net} / {t.pricing.care.per}
                </small>
              </strong>
              <p>
                {t.pricing.care.gross} {t.pricing.grossLabel}
              </p>
            </div>
            <a href="#cennik" aria-label={t.nav.prices}>
              <Icon name="diagonal" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="jak" class="section process" aria-labelledby="process-title">
      <div class="wrap">
        <div class="section__head">
          <div>
            <p class="eyebrow">{t.process.title}</p>
            <h2 class="line-breaks" id="process-title">
              {r.processTitle}
            </h2>
          </div>
          <p class="lead">{t.process.lead}</p>
        </div>
        <ol class="process__steps">
          {t.process.steps.map((step, i) => (
            <li>
              <span class="process__number">{String(i + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="cennik" class="section pricing" aria-labelledby="pricing-title">
      <div class="wrap">
        <div class="section__head">
          <div>
            <p class="eyebrow">{r.pricingEyebrow}</p>
            <h2 id="pricing-title">{r.pricingTitle}</h2>
          </div>
          <p class="lead">{t.pricing.lead}</p>
        </div>
        <div class="pricing__in">
          <div class="pricing__rates">
            <p class="fine">{t.pricing.fine}</p>
            <dl class="rates">
              {t.pricing.rates.map((rate) => (
                <div class:list={['rates__row', { 'rates__row--extra': rate.extra }]}>
                  <dt>
                    {rate.label}
                    {rate.note && <small>{rate.note}</small>}
                  </dt>
                  <dd>
                    <strong>{rate.price}</strong>
                    {rate.gross && (
                      <span>
                        {rate.gross} {t.pricing.grossLabel}
                      </span>
                    )}
                  </dd>
                </div>
              ))}
            </dl>
            <p class="fine">{t.pricing.surcharges}</p>
            <div class="pricing__care">
              <Icon name="home" />
              <div>
                <h3>{t.pricing.care.title}</h3>
                <p>{t.pricing.care.points.join(' · ')}</p>
              </div>
            </div>
          </div>
          <PriceEstimator lang={lang} />
        </div>
      </div>
    </section>

    <section id="obszar" class="area" aria-labelledby="area-title">
      <div class="wrap area__in">
        <div>
          <p class="eyebrow">{r.areaEyebrow}</p>
          <h2 class="line-breaks" id="area-title">
            {r.areaTitle}
          </h2>
          <p>{r.areaNote}</p>
        </div>
        <div class="area__places">
          <p class="area__radius">
            <Icon name="pin" />
            <strong>{site.radiusKm} km</strong>
            <span>Jelenia Góra</span>
          </p>
          <ul>
            {site.areas.map((place) => (
              <li>{place}</li>
            ))}
          </ul>
        </div>
      </div>
      <div class="area__landscape" aria-hidden="true"></div>
    </section>

    <section id="zaufanie" class="section trust" aria-labelledby="trust-title">
      <div class="wrap">
        <h2 class="eyebrow" id="trust-title">
          {t.trust.title}
        </h2>
        <div class="trust__grid">
          {t.trust.items.map((item, i) => (
            <div>
              <Icon name={['shield', 'camera', 'person'][i]} />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
        {site.gallery.length > 0 && (
          <div class="extra-gallery">
            <h2>{t.gallery.title}</h2>
            <div>
              {site.gallery.map((image) => (
                <img src={image.src} alt={image.alt[lang]} loading="lazy" decoding="async" />
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <section id="pytania" class="section faq" aria-labelledby="faq-title">
      <div class="wrap faq__in">
        <div>
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">{t.faq.title}</h2>
          <p class="lead">{t.faq.lead}</p>
          <a class="text-link" href="#kontakt">
            {t.faq.more}
            <Icon name="arrow" />
          </a>
        </div>
        <div class="faq__list">
          {t.faq.items.map((item) => (
            <details class="faq__item">
              <summary>
                {item.q}
                <Icon name="plus" />
              </summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="kontakt" class="section contact" aria-labelledby="contact-title">
      <div class="wrap contact__in">
        <div class="contact__copy">
          <p class="eyebrow">{r.contactEyebrow}</p>
          <h2 class="line-breaks" id="contact-title">
            {r.contactTitle}
          </h2>
          <div class="direct">
            <p>{t.contact.direct}</p>
            <a class="direct__phone" href={`tel:${tel}`}>
              {site.phone}
              <Icon name="diagonal" />
            </a>
            <a href={wa} target="_blank" rel="noopener">
              <Icon name="chat" />
              {t.contact.whatsappDirect}
            </a>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <p class="contact__area">
            <Icon name="pin" />
            {t.contact.area}
          </p>
        </div>
        <ContactForm lang={lang} />
      </div>
    </section>
  </main>
  <Footer lang={lang} />
  <nav class="quick" aria-label={t.contact.direct}>
    <a href={`tel:${tel}`}>
      <Icon name="phone" />
      {t.call}
    </a>
    <a href={wa} target="_blank" rel="noopener">
      <Icon name="chat" />
      WhatsApp
    </a>
  </nav>
</Base>
