---
// Strona główna przekierowuje na wersję językową.
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <title>Handyman</title>
    <meta http-equiv="refresh" content="0; url=/pl/" />
    <link rel="canonical" href="/pl/" />
    <script is:inline>
      try {
        var l = (navigator.language || 'pl').slice(0, 2).toLowerCase();
        location.replace('/' + (l === 'de' || l === 'en' ? l : 'pl') + '/');
      } catch (e) {}
    </script>
  </head>
  <body><a href="/pl/">Handyman</a></body>
</html>
