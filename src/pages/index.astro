---
// Strona główna: wybór języka. Przekierowuje według języka przeglądarki, bez JS przez meta refresh.
import { locales, site } from '../config';
import { ORIGIN } from '../lib/seo';
const names = { pl: 'Polski', de: 'Deutsch', en: 'English' } as const;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name}</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={`${ORIGIN}/pl/`} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={`${ORIGIN}/${l}/`} />)}
    <link rel="alternate" hreflang="x-default" href={`${ORIGIN}/pl/`} />
    <meta http-equiv="refresh" content="0; url=/pl/" />
    <script is:inline>
      try {
        var l = (navigator.language || 'pl').slice(0, 2).toLowerCase();
        location.replace('/' + (l === 'de' || l === 'en' ? l : 'pl') + '/');
      } catch (e) {}
    </script>
  </head>
  <body>
    <ul>{locales.map((l) => <li><a href={`/${l}/`} hreflang={l} lang={l}>{names[l]}</a></li>)}</ul>
  </body>
</html>
