---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { privacyPath } from '../i18n/privacy';
import { content } from '../i18n/content';
import { site } from '../config';

const t = content.pl;
const pr = t.pricing;
const tel = site.phone.replace(/\s/g, '');
// Numer w kontakcie: kierunkowy mniejszy, sam numer w skali nagłówka
const [cc, ...rest] = site.phone.split(' ');
const local = rest.join(' ');
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(t.waGreeting)}`;
// Trzy zdjęcia w jednym rzędzie; --ar = proporcje, więc w rzędzie mają równą wysokość bez kadrowania
const photos = [
  { id: 'malowanie', w: 1600, h: 1200 },
  { id: 'detal', w: 1200, h: 1600 },
  { id: 'gotowe', w: 1200, h: 1600 },
] as const;
---
<Base lang="pl" htmlLang={t.htmlLang} title={t.meta.title} description={t.meta.description} imageAlt={`${site.name} – ${t.brand.sub}`}>
  <a class="skip" href="#main">Przejdź do treści</a>

  <Header lang="pl" />

  <main id="main" tabindex="-1">
    <section class="hero" data-hero>
      <div class="wrap hero__in">
        <h1>{t.hero.title}</h1>
        <div class="hero__side">
          <div class="hero__main">
            <p class="lead">{t.hero.lead}</p>
            <div class="actions" data-hero-actions>
              <a class="btn" href="#kontakt">{t.hero.primary}</a>
              <a class="call-link" href={`tel:${tel}`}>{site.phone}</a>
            </div>
          </div>
          <div class="proof">
            <p class="proof__line">
              <span>{t.hero.proof.label}</span>
              <span class="proof__price">{t.hero.proof.price}</span>
            </p>
            <p class="proof__sub">
              <span>{t.hero.proof.gross}, {t.hero.proof.area}.</span>
              <a href="#cennik">{t.hero.proof.link}</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="uslugi" class="section" aria-labelledby="uslugi-h">
      <div class="wrap">
        <div class="section__head">
          <h2 id="uslugi-h">{t.services.title}</h2>
          <p class="lead">{t.services.lead}</p>
        </div>
        <ul class="svc" data-rule>
          {t.services.items.map((s) => (
            <li class="svc__item">
              <h3>{s.name}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ul>
        <p class="credential">{t.services.note}</p>
      </div>
    </section>

    <section id="opieka" class="section section--stone" aria-labelledby="opieka-h">
      <div class="wrap care">
        <div class="care__head">
          <h2 id="opieka-h">{t.care.title}</h2>
          <p class="care__quote">{t.care.quote}</p>
          <p class="lead">{t.care.lead}</p>
        </div>
        <div class="care__body">
          <div class="care__main">
            <ul class="care__points" data-rule>
              {t.care.points.map((p) => (
                <li>
                  <h3>{p.title}</h3>
                  <p>{p.text}</p>
                </li>
              ))}
            </ul>
            <a class="btn" href="#kontakt" data-topic="1">{t.care.cta}</a>
          </div>
          <div class="visit" role="group" aria-labelledby="visit-h" data-rule>
            <p class="visit__head">
              <span class="visit__title" id="visit-h">{t.care.visit.title}</span>
              <span class="label">{t.care.visit.label}</span>
            </p>
            <ul>
              {t.care.visit.entries.map((e) => (
                <li>
                  <span class="visit__where">{e.where}</span>
                  <span class="visit__what">{e.what}</span>
                  <span class="visit__done">{e.done}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="cennik" class="section section--frost" aria-labelledby="cennik-h">
      <div class="wrap price">
        <div class="section__head price__head">
          <h2 id="cennik-h">{pr.title}</h2>
          <p class="lead">{pr.lead}</p>
        </div>

        <div class="price__rates">
          <p class="rates__legend">{pr.fine}</p>
          <dl class="rates" data-rule>
            {pr.rates.map((r) => (
              <div class="rates__row">
                <dt>{r.label}</dt>
                <dd class:list={['rates__price', { 'rates__price--text': r.text }]}>
                  <span>{r.price}</span>
                  {r.gross && <span class="rates__gross">{r.gross} {pr.grossLabel}</span>}
                </dd>
                {r.note && <dd class="rates__note">{r.note}</dd>}
              </div>
            ))}
            <div class="rates__row">
              <dt>{pr.care.title} <span class="rates__per">{pr.care.per}</span></dt>
              <dd class="rates__price">
                <span>{pr.care.price}</span>
                <span class="rates__gross">{pr.care.gross} {pr.grossLabel}</span>
              </dd>
              <dd class="rates__note">{pr.care.points.join(', ')}.</dd>
            </div>
          </dl>
          <ul class="rates__extras">
            {pr.extras.map((x) => <li><span>{x.label}</span> <span class="rates__extra">{x.price}</span></li>)}
            <li class="rates__fine">{pr.surcharges}</li>
          </ul>
          <div class="zones" aria-labelledby="zones-h">
            <p class="zones__title label" id="zones-h">{pr.zones.title}</p>
            <dl>
              {pr.zones.items.map((z) => (
                <div class="zones__row">
                  <dt><span class="zones__name">{z.name}</span> <span class="zones__price">{z.price}</span></dt>
                  <dd>{z.text}</dd>
                </div>
              ))}
            </dl>
            <p class="rates__fine">{site.zones.outside}</p>
          </div>
        </div>

        <div class="bill" role="group" aria-labelledby="bill-h">
          <div class="bill__sheet">
            <p class="bill__title" id="bill-h">{pr.bill.title}</p>
            <p class="bill__meta">
              <span>{pr.bill.place}</span>
              <span>{pr.bill.job}</span>
              <span>{pr.bill.time}</span>
            </p>
            <table class="bill__lines">
              <tbody>
                {pr.bill.lines.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
              </tbody>
              <tfoot>
                <tr class="bill__sub"><th scope="row">{pr.bill.subtotal[0]}</th><td>{pr.bill.subtotal[1]}</td></tr>
                <tr><th scope="row">{pr.bill.vat[0]}</th><td>{pr.bill.vat[1]}</td></tr>
                <tr class="bill__total"><th scope="row">{pr.bill.total[0]}</th><td>{pr.bill.total[1]}</td></tr>
              </tfoot>
            </table>
            <p class="bill__status label">{pr.bill.status}</p>
          </div>
          <p class="bill__note">{pr.bill.note}</p>
        </div>
      </div>
    </section>

    <section id="realizacja" class="section" aria-labelledby="realizacja-h">
      <div class="wrap">
        <div class="section__head work__head">
          <h2 id="realizacja-h">{t.work.title}</h2>
          <p class="lead">{t.work.lead}</p>
          <p class="work__meta">{t.work.meta}</p>
        </div>
        <div class="work__row">
          {photos.map((p, i) => (
            <figure class:list={['work__photo', { 'work__photo--wide': i === 0 }]} style={`--ar: ${(p.w / p.h).toFixed(3)}`}>
              <div class="work__frame"><img
                src={`/img/mural-${p.id}-1600.webp`}
                srcset={`/img/mural-${p.id}-900.webp 900w, /img/mural-${p.id}-1600.webp 1600w`}
                sizes={i === 0 ? '(min-width: 64rem) 50vw, 92vw' : '(min-width: 64rem) 25vw, 46vw'}
                width={p.w} height={p.h}
                alt={t.work.photos[p.id].alt}
                loading="lazy" decoding="async"
              /></div>
              <figcaption>{t.work.photos[p.id].caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="pytania" class="section section--stone section--quiet" aria-labelledby="pytania-h">
      <div class="wrap faq">
        <div class="faq__head">
          <h2 id="pytania-h">{t.faq.title}</h2>
          <a class="text-link" href="#kontakt">{t.faq.more}</a>
        </div>
        <div class="faq__list" data-rule>
          {t.faq.items.map((f) => (
            <details class="faq__item">
              <summary>
                <span>{f.q}</span><i class="faq__sign" aria-hidden="true"></i>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="kontakt" class="contact" aria-labelledby="kontakt-h">
      <div class="wrap contact__in">
        <div class="contact__lead">
          <h2 id="kontakt-h" class="h-statement">{t.contact.title}</h2>
          <ol class="steps" data-rule>
            {t.contact.steps.map((s) => (
              <li>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))}
          </ol>
          <div class="direct">
            <p class="label">{t.contact.direct}</p>
            <a class="direct__tel" href={`tel:${tel}`} aria-label={site.phone}><span class="direct__cc">{cc}</span>{local}</a>
            <p class="direct__links">
              <a href={wa} target="_blank" rel="noopener">{t.contact.whatsappDirect}</a>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          </div>
        </div>

        <form id="lead" class="form" novalidate data-wa={site.whatsapp} data-mail={site.email}
          data-l-name={t.contact.form.name} data-l-phone={t.contact.form.phone} data-l-topic={t.contact.form.topic}
          data-l-who={t.contact.form.who} data-l-where={t.contact.form.where} data-l-what={t.contact.form.what}
          data-sent-wa={t.contact.form.sentWa} data-blocked-wa={t.contact.form.blockedWa} data-sent-mail={t.contact.form.sentMail}>
          <div class="field">
            <label for="f-name">{t.contact.form.name}</label>
            <input id="f-name" name="name" autocomplete="name" required aria-describedby="e-name" />
            <p id="e-name" class="field__error" hidden>{t.contact.form.errName}</p>
          </div>
          <div class="field">
            <label for="f-phone">{t.contact.form.phone} <span class="field__opt">({t.contact.form.optional})</span></label>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
          </div>
          <div class="field__pair">
            <div class="field">
              <label for="f-topic">{t.contact.form.topic}</label>
              <select id="f-topic" name="topic">
                {t.contact.form.topicOptions.map((o) => <option value={o}>{o}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="f-who">{t.contact.form.who}</label>
              <select id="f-who" name="who">
                {t.contact.form.whoOptions.map((o) => <option value={o}>{o}</option>)}
              </select>
            </div>
          </div>
          <div class="field">
            <label for="f-where">{t.contact.form.where} <span class="field__opt">({t.contact.form.optional})</span></label>
            <input id="f-where" name="where" placeholder={t.contact.form.wherePlaceholder} />
          </div>
          <div class="field">
            <label for="f-what">{t.contact.form.what}</label>
            <textarea id="f-what" name="what" rows="4" required aria-describedby="e-what" placeholder={t.contact.form.whatPlaceholder}></textarea>
            <p id="e-what" class="field__error" hidden>{t.contact.form.errWhat}</p>
          </div>
          <div class="form__send">
            <button class="btn" type="button" data-send="wa">{t.contact.form.whatsapp}</button>
            <button class="btn btn--ghost" type="button" data-send="mail">{t.contact.form.email}</button>
          </div>
          <p class="form__status" role="status" aria-live="polite"></p>
          <p class="form__fine">{t.contact.form.hint} <a href={privacyPath}>{t.contact.form.privacy}</a>.</p>
        </form>
      </div>
    </section>
  </main>

  <Footer lang="pl" />

  <nav class="quick is-hidden" aria-label="Szybki kontakt" data-quick>
    <a class="quick__btn quick__btn--call" href={`tel:${tel}`}>{t.call}</a>
    <a class="quick__btn" href={wa} target="_blank" rel="noopener">WhatsApp</a>
  </nav>

  <script>
    // --- Formularz: wiadomość do WhatsAppa lub poczty, błędy przy polach ---
    const form = document.getElementById('lead') as HTMLFormElement | null;
    if (form) {
      const d = form.dataset;
      const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
      const required = ['name', 'what'];
      const status = form.querySelector<HTMLElement>('.form__status');
      const setError = (n: string, on: boolean) => {
        const el = field(n);
        el.setAttribute('aria-invalid', String(on));
        const msg = document.getElementById(`e-${n}`);
        if (msg) msg.hidden = !on;
      };
      const build = () => {
        const f = new FormData(form);
        const line = (label = '', key: string) => `${label}: ${f.get(key) || ''}`;
        return [
          line(d.lName, 'name'),
          line(d.lPhone, 'phone'),
          line(d.lTopic, 'topic'),
          line(d.lWho, 'who'),
          line(d.lWhere, 'where'),
          '',
          `${d.lWhat}:`,
          `${f.get('what') || ''}`,
        ].join('\n');
      };
      const valid = () => {
        const empty = required.filter((n) => field(n).value.trim() === '');
        required.forEach((n) => setError(n, empty.includes(n)));
        if (empty.length) field(empty[0]).focus();
        return empty.length === 0;
      };
      // Błąd znika, gdy tylko pole zostanie uzupełnione
      required.forEach((n) =>
        field(n).addEventListener('input', () => {
          if (field(n).getAttribute('aria-invalid') === 'true' && field(n).value.trim() !== '') setError(n, false);
        }),
      );
      form.querySelectorAll<HTMLButtonElement>('[data-send]').forEach((b) =>
        b.addEventListener('click', () => {
          if (status) status.textContent = '';
          if (!valid()) return;
          const text = build();
          if (b.dataset.send === 'wa') {
            // Bez „noopener” w window.open, bo wtedy przeglądarka zawsze zwraca null i nie wiemy, czy okno się otworzyło
            const w = window.open(`https://wa.me/${d.wa}?text=${encodeURIComponent(text)}`, '_blank');
            if (w) w.opener = null;
            if (status) status.textContent = (w ? d.sentWa : d.blockedWa) || '';
          } else {
            const subject = `handyman.karkonosze – ${field('topic').value}`;
            location.href = `mailto:${d.mail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}`;
            if (status) status.textContent = d.sentMail || '';
          }
        }),
      );
      // „Zapytaj o stałą opiekę” ustawia temat formularza
      document.querySelectorAll<HTMLAnchorElement>('[data-topic]').forEach((a) =>
        a.addEventListener('click', () => {
          const topic = field('topic') as HTMLSelectElement;
          topic.selectedIndex = Number(a.dataset.topic) || 0;
        }),
      );
    }

    // --- Pasek szybkiego kontaktu na telefonie: dopiero gdy przyciski z otwarcia zniknęły, chowa się przy formularzu ---
    const quick = document.querySelector<HTMLElement>('[data-quick]');
    const heroActions = document.querySelector('[data-hero-actions]');
    const contact = document.getElementById('kontakt');
    if (quick && heroActions && contact && 'IntersectionObserver' in window) {
      let heroSeen = true;
      let contactSeen = false;
      const update = () => quick.classList.toggle('is-hidden', heroSeen || contactSeen);
      new IntersectionObserver(([en]) => { heroSeen = en.isIntersecting || en.boundingClientRect.top > 0; update(); }).observe(heroActions);
      new IntersectionObserver(([en]) => { contactSeen = en.isIntersecting; update(); }, { threshold: 0.15 }).observe(contact);
    }
  </script>
</Base>
