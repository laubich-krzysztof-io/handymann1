---
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { content } from '../i18n/content';
import { privacyPath } from '../i18n/privacy';
import { site, type Lang } from '../config';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
---

<footer class="foot">
  <div class="wrap foot__in">
    <a class="brand" href={`/${lang}/`} aria-label={site.name}>
      <Mark class="brand__mark" />
      <span class="brand__text">
        <strong>
          handyman<span>.</span>
        </strong>
        <span>karkonosze</span>
      </span>
    </a>
    <p>
      <Icon name="mountain" />
      {t.footer.area}
    </p>
    <a href={privacyPath(lang)}>{t.footer.privacy}</a>
  </div>
  <div class="wrap foot__bottom">
    <span>
      © {new Date().getFullYear()} {site.company || site.name}
      {site.nip && ` · NIP ${site.nip}`}
    </span>
    <span>PL / DE / EN</span>
  </div>
</footer>
