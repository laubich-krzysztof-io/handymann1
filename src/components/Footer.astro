---
import Mark from './Mark.astro';
import { content } from '../i18n/content';
import { privacyPath } from '../i18n/privacy';
import { site, type Lang } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const tel = site.phone.replace(/\s/g, '');
const legal = [site.company || site.name, site.address, site.nip && `NIP ${site.nip}`].filter(Boolean).join(', ');
---
<footer class="foot">
  <div class="wrap foot__in">
    <div class="foot__top">
      <span class="foot__brand"><Mark class="foot__mark" />{site.name}</span>
      <p class="foot__contact">
        <a href={`tel:${tel}`}>{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
    <div class="foot__legal">
      <span>{t.brand.sub}. {t.footer.area}.</span>
      <a href={privacyPath}>{t.footer.privacy}</a>
      <span>© {new Date().getFullYear()} {legal}. {t.footer.rights}</span>
    </div>
  </div>
</footer>
