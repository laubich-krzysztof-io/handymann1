---
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { content } from '../i18n/content';
import { locales, site, type Lang } from '../config';
interface Props {
  lang: Lang;
  sub?: boolean;
  alternates?: Record<Lang, string>;
}
const { lang, sub = false } = Astro.props;
const t = content[lang];
const home = sub ? `/${lang}/` : '';
const alt = Astro.props.alternates ?? Object.fromEntries(locales.map((l) => [l, `/${l}/`]));
const labels = {
  pl: ['Menu główne', 'Język', 'Otwórz menu', 'Zamknij menu'],
  de: ['Hauptmenü', 'Sprache', 'Menü öffnen', 'Menü schließen'],
  en: ['Main menu', 'Language', 'Open menu', 'Close menu'],
}[lang];
const links = [
  ['uslugi', t.nav.services],
  ['realizacja', t.nav.work],
  ['opieka', t.nav.care],
  ['cennik', t.nav.prices],
];
---

<header class="top" data-header>
  <div class="wrap top__in">
    <a class="brand" href={`/${lang}/`} aria-label={site.name}>
      <Mark class="brand__mark" />
      <span class="brand__text">
        <strong>
          handyman<span>.</span>
        </strong>
        <span>karkonosze</span>
      </span>
    </a>
    <nav class="nav" id="main-navigation" aria-label={labels[0]}>
      {links.map(([id, label]) => (
        <a href={`${home}#${id}`}>{label}</a>
      ))}
      <a class="nav__mobile-contact" href={`${home}#kontakt`}>
        {t.hero.primary}
        <Icon name="arrow" />
      </a>
    </nav>
    <div class="top__end">
      <ul class="lang" aria-label={labels[1]}>
        {locales.map((l) => (
          <li>
            <a href={alt[l]} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
              {l.toUpperCase()}
            </a>
          </li>
        ))}
      </ul>
      <a class="top__call" href={`tel:${site.phone.replace(/\s/g, '')}`}>
        <Icon name="phone" />
        <span>{site.phone}</span>
      </a>
      <button
        class="burger"
        type="button"
        aria-controls="main-navigation"
        aria-expanded="false"
        aria-label={labels[2]}
        data-open-label={labels[2]}
        data-close-label={labels[3]}
        hidden
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('.burger');
  const nav = header?.querySelector<HTMLElement>('.nav');
  if (header && toggle && nav) {
    header.classList.add('is-enhanced');
    toggle.hidden = false;
    const setOpen = (open: boolean, restoreFocus = false) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute(
        'aria-label',
        (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel)!,
      );
      if (restoreFocus) toggle.focus();
    };
    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
    );
    nav
      .querySelectorAll('a')
      .forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true')
        setOpen(false, true);
    });
    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) setOpen(false);
    });
    header.addEventListener('focusout', (event) => {
      if (!header.contains(event.relatedTarget as Node)) setOpen(false);
    });
    matchMedia('(min-width: 1100px)').addEventListener('change', () => setOpen(false));
    header.querySelectorAll<HTMLAnchorElement>('.lang a').forEach((link) =>
      link.addEventListener('click', () => {
        link.hash = location.hash;
      }),
    );
  }
</script>
