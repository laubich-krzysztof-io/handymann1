---
import Mark from './Mark.astro';
import { content } from '../i18n/content';
import { locales, site, type Lang } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];

const brandSub: Record<Lang, string> = {
  pl: 'Serwis dla domu i pensjonatu',
  de: 'Service für Haus und Pension',
  en: 'Service for home and guesthouse',
};
const realizacje: Record<Lang, string> = { pl: 'Realizacje', de: 'Referenzen', en: 'Work' };
const navLabel: Record<Lang, string> = { pl: 'Menu główne', de: 'Hauptmenü', en: 'Main menu' };
const langLabel: Record<Lang, string> = { pl: 'Język', de: 'Sprache', en: 'Language' };
const menuLabel: Record<Lang, { open: string; close: string }> = {
  pl: { open: 'Otwórz menu', close: 'Zamknij menu' },
  de: { open: 'Menü öffnen', close: 'Menü schließen' },
  en: { open: 'Open menu', close: 'Close menu' },
};
const [word1, word2] = site.name.split('.');
// Krótka etykieta przycisku w pasku (ten sam cel co przycisk w hero)
const ctaLabel: Record<Lang, string> = { pl: t.hero.primary, de: 'Schaden melden', en: 'Report a fault' };
const links = [
  { id: 'realizacja', label: realizacje[lang] },
  { id: 'opieka', label: t.nav.care },
  { id: 'jak', label: t.nav.process },
];
---
<header class="top" data-top data-label-open={menuLabel[lang].open} data-label-close={menuLabel[lang].close}>
  <div class="top__scene" aria-hidden="true">
    <span class="top__strip"></span>
    <span class="top__sniezka"></span>
    <span class="top__forest"></span>
  </div>
  <div class="top__in">
    <a class="brand" href={`/${lang}/`} aria-label={`${site.name} – ${brandSub[lang]}`}>
      <Mark class="brand__mark" />
      <span class="brand__text">
        <span class="brand__name">{word1}<span class="brand__dot">.</span>{word2}</span>
        <span class="brand__sub">{brandSub[lang]}</span>
      </span>
    </a>

    <nav class="nav" id="nav" aria-label={navLabel[lang]}>
      <ul class="nav__list">
        <li class="nav__item nav__item--menu" data-menu>
          <button class="nav__link nav__btn" type="button" aria-expanded="false" aria-controls="menu-uslugi" data-spy="uslugi">
            {t.nav.services}
            <svg class="nav__chev" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5 10 12.5 15 7.5" /></svg>
          </button>
          <ul class="nav__menu" id="menu-uslugi">
            {t.services.items.map((s, i) => (
              <li>
                <a href={`#usluga-${i + 1}`}>
                  <span class="nav__menu-name">{s.name}</span>
                  <span class="nav__menu-ex">{s.examples}</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
        {links.map((l) => (
          <li class="nav__item"><a class="nav__link" href={`#${l.id}`} data-spy={l.id}>{l.label}</a></li>
        ))}
      </ul>
      <div class="nav__extra">
        <ul class="lang" aria-label={langLabel[lang]}>
          {locales.map((l) => (
            <li><a href={`/${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a></li>
          ))}
        </ul>
        <a class="cta" href="#kontakt">{ctaLabel[lang]}</a>
      </div>
    </nav>

    <div class="top__end">
      <ul class="lang" aria-label={langLabel[lang]}>
        {locales.map((l) => (
          <li><a href={`/${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a></li>
        ))}
      </ul>
      <a class="cta" href="#kontakt">{ctaLabel[lang]}</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="nav" aria-label={menuLabel[lang].open} data-burger>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="burger__a" d="M4 7h16" /><path class="burger__b" d="M4 12h16" /><path class="burger__c" d="M4 17h16" /></svg>
      </button>
    </div>
  </div>
</header>
<div class="top-space" aria-hidden="true"></div>

<script>
  const top = document.querySelector<HTMLElement>('[data-top]');
  if (top) {
    // Compact bar after the first scroll
    let ticking = false;
    // Hysteresis: collapse past 56px, expand only back near the top (no flicker on small scrolls)
    const compact = () => {
      const y = window.scrollY;
      const on = top.classList.contains('is-compact');
      if (!on && y > 56) top.classList.add('is-compact');
      else if (on && y < 8) top.classList.remove('is-compact');
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(compact); }
    }, { passive: true });
    // Pierwszy odczyt w klatce animacji: bez wymuszonego przeliczania układu przy starcie
    requestAnimationFrame(() => {
      compact();
      // Wejście pejzażu (Śnieżka z mgły) tylko gdy strona startuje u góry
      if (window.scrollY < 56) top.classList.add('is-intro');
    });

    // "Usługi" disclosure
    const item = top.querySelector<HTMLElement>('[data-menu]');
    const btn = item?.querySelector<HTMLButtonElement>('button');
    const setMenu = (open: boolean) => btn?.setAttribute('aria-expanded', String(open));
    const isOpen = () => btn?.getAttribute('aria-expanded') === 'true';
    btn?.addEventListener('click', () => setMenu(!isOpen()));
    let leave: number | undefined;
    const wide = window.matchMedia('(hover: hover) and (min-width: 80rem)');
    item?.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || !wide.matches) return;
      window.clearTimeout(leave); setMenu(true);
    });
    item?.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse' || !wide.matches) return;
      leave = window.setTimeout(() => setMenu(false), 160);
    });
    item?.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node)) setMenu(false);
    });

    // Mobile panel
    const burger = top.querySelector<HTMLButtonElement>('[data-burger]');
    const setPanel = (open: boolean) => {
      top.classList.toggle('is-open', open);
      burger?.setAttribute('aria-expanded', String(open));
      burger?.setAttribute('aria-label', (open ? top.dataset.labelClose : top.dataset.labelOpen) || '');
    };
    burger?.addEventListener('click', () => setPanel(!top.classList.contains('is-open')));

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (item && !item.contains(target)) setMenu(false);
      if (!top.contains(target)) setPanel(false);
    });
    top.querySelectorAll<HTMLAnchorElement>('.nav a').forEach((a) =>
      a.addEventListener('click', () => { setMenu(false); setPanel(false); }),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (isOpen()) { setMenu(false); btn?.focus(); }
      else if (top.classList.contains('is-open')) { setPanel(false); burger?.focus(); }
    });

    // Current section underline
    const spies = [...top.querySelectorAll<HTMLElement>('[data-spy]')];
    const sections = spies
      .map((el) => document.getElementById(el.dataset.spy || ''))
      .filter((s): s is HTMLElement => !!s);
    const mark = (id: string | null) => spies.forEach((el) => {
      const on = el.dataset.spy === id;
      el.classList.toggle('is-current', on);
      if (el.tagName === 'A') on ? el.setAttribute('aria-current', 'location') : el.removeAttribute('aria-current');
    });
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) mark(en.target.id); });
    }, { rootMargin: '-40% 0px -55% 0px' });
    sections.forEach((s) => io.observe(s));
    window.addEventListener('scroll', () => { if (window.scrollY < 80) mark(null); }, { passive: true });
  }
</script>
