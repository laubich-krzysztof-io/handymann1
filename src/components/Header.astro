---
// Nagłówek jak w referencji: przezroczysty na zdjęciu otwarcia, po przewinięciu grafitowy pasek.
// Po prawej menu i żółty przycisk zgłoszenia; na telefonie „Menu” otwiera panel na cały ekran.
import Mark from './Mark.astro';
import { content } from '../i18n/content';
import { site, type Lang } from '../config';

interface Props {
  lang: Lang;
  /** Podstrona: pasek od razu grafitowy, kotwice prowadzą do strony głównej */
  sub?: boolean;
}
const { lang, sub = false } = Astro.props;
const home = sub ? '/' : '';
const t = content[lang];
const tel = site.phone.replace(/\s/g, '');
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(t.waGreeting)}`;
const [word1, word2] = site.name.split('.');
const links = [
  { id: 'uslugi', label: t.nav.services },
  { id: 'opieka', label: t.nav.care },
  { id: 'cennik', label: t.nav.prices },
  { id: 'realizacja', label: t.nav.work },
];
---
<header class:list={['top', { 'is-solid': sub, 'top--sub': sub }]} data-top>
  <div class="top__in">
    <a class="brand" href="/" aria-label={`${site.name} – ${t.brand.sub}`}>
      <Mark class="brand__mark" />
      <span class="brand__name"><span>{word1}</span><span>.{word2}</span></span>
    </a>
    <nav class="nav" id="nav" aria-label="Menu główne">
      <ul class="nav__list">
        {links.map((l) => <li><a class="nav__link" href={`${home}#${l.id}`}>{l.label}</a></li>)}
      </ul>
      <div class="nav__extra">
        <a class="nav__tel" href={`tel:${tel}`}>{site.phone}</a>
        <a class="nav__wa" href={wa} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </nav>
    <a class="btn btn--yellow top__cta" href={`${home}#kontakt`}>{t.hero.primary}</a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="nav" data-burger>
      <span class="burger__bars" aria-hidden="true"></span><span class="burger__label" data-burger-label>Menu</span>
    </button>
  </div>
</header>

<script>
  const top = document.querySelector<HTMLElement>('[data-top]');
  if (top) {
    const sub = top.classList.contains('top--sub');
    // Grafitowy pasek po zjechaniu z otwarcia
    let ticking = false;
    const solid = () => {
      if (!sub) top.classList.toggle('is-solid', window.scrollY > 40);
      ticking = false;
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(solid); } }, { passive: true });
    requestAnimationFrame(solid);

    const burger = top.querySelector<HTMLButtonElement>('[data-burger]');
    const label = top.querySelector<HTMLElement>('[data-burger-label]');
    const set = (open: boolean) => {
      top.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('menu-open', open);
      burger?.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Zamknij' : 'Menu';
    };
    burger?.addEventListener('click', () => {
      const open = !top.classList.contains('is-open');
      set(open);
      if (open) top.querySelector<HTMLAnchorElement>('.nav a')?.focus();
    });
    top.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && top.classList.contains('is-open')) { set(false); burger?.focus(); }
    });
    top.addEventListener('focusout', (e) => {
      if (top.classList.contains('is-open') && !top.contains(e.relatedTarget as Node | null)) set(false);
    });
  }
</script>
